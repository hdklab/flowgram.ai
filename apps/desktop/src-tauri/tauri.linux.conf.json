{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "linux/flowgram.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/flowgram.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
